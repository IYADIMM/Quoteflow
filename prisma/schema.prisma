generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_REP
  VIEWER
}

enum QuoteStatus {
  DRAFT
  INTERNAL_REVIEW
  SENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RFQStatus {
  NEW
  REVIEWING
  PRICING
  QUOTED
  WON
  LOST
  EXPIRED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SNOOZED
}

enum CatalogType {
  PRODUCT
  SERVICE
  LABOR
  MATERIAL
  PACKAGE
}

enum IntegrationKind {
  AI
  EMAIL
  STORAGE
  BILLING
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  auditLogs AuditLog[]
  assignedFollowUps FollowUp[]
  resetTokens PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  sentInvitations Invitation[] @relation("InvitationCreator")
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  organizationId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
}
model Organization {
  id String @id @default(cuid())
  name String
  reportingCurrency String @default("AED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  settings CompanySettings?
  customers Customer[]
  catalogItems CatalogItem[]
  rfqs RFQ[]
  quotes Quote[]
  followUps FollowUp[]
  subscription Subscription?
  aiUsage AIUsage[]
  auditLogs AuditLog[]
  attachments Attachment[]
  integrations Integration[]
  invitations Invitation[]
  stripeEvents StripeEvent[]
  deletionRequests OrganizationDeletionRequest[]
}
model Membership {
  id String @id @default(cuid())
  userId String
  organizationId String
  role Role
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([userId, organizationId])
  @@index([organizationId, role])
}
model Invitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role Role
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  invitedById String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  invitedBy User? @relation("InvitationCreator", fields:[invitedById], references:[id], onDelete:SetNull)
  @@index([organizationId, email, acceptedAt])
  @@index([expiresAt])
}
model Customer {
  id String @id @default(cuid())
  organizationId String
  companyName String
  contactName String?
  email String?
  phone String?
  whatsapp String?
  address String?
  country String?
  industry String?
  taxNumber String?
  notes String?
  assignedUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  rfqs RFQ[]
  quotes Quote[]
  @@index([organizationId, companyName])
  @@index([organizationId, deletedAt])
}
model CatalogItem {
  id String @id @default(cuid())
  organizationId String
  sku String?
  name String
  description String?
  category String?
  brand String?
  type CatalogType @default(PRODUCT)
  unit String @default("each")
  cost Decimal @db.Decimal(16,4)
  sellingPrice Decimal @db.Decimal(16,4)
  minimumPrice Decimal? @db.Decimal(16,4)
  taxRate Decimal @default(0) @db.Decimal(7,4)
  currency String
  active Boolean @default(true)
  leadTimeDays Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  rfqItems RFQItem[]
  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, active, deletedAt])
}
model RFQ {
  id String @id @default(cuid())
  organizationId String
  number String
  title String
  customerId String
  receivedAt DateTime @default(now())
  deadline DateTime?
  status RFQStatus @default(NEW)
  priority String @default("Normal")
  source String?
  notes String?
  assignedUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  items RFQItem[]
  quotes Quote[]
  attachments Attachment[]
  @@unique([organizationId, number])
  @@index([organizationId, status, deadline])
}
model RFQItem {
  id String @id @default(cuid())
  rfqId String
  catalogItemId String?
  description String
  quantity Decimal @db.Decimal(16,4)
  unit String?
  notes String?
  sourceText String?
  confidence Decimal? @db.Decimal(5,4)
  rfq RFQ @relation(fields:[rfqId], references:[id], onDelete:Cascade)
  catalogItem CatalogItem? @relation(fields:[catalogItemId], references:[id], onDelete:SetNull)
  @@index([rfqId])
}
model Quote {
  id String @id @default(cuid())
  organizationId String
  number String
  customerId String
  rfqId String?
  title String
  status QuoteStatus @default(DRAFT)
  currency String
  issueDate DateTime @default(now())
  expiryDate DateTime?
  discount Decimal @default(0) @db.Decimal(16,4)
  paymentTerms String?
  deliveryTerms String?
  customerNotes String?
  internalNotes String?
  publicTokenHash String? @unique
  publicTokenExpiresAt DateTime?
  sendAttemptKey String?
  sendAttemptState String?
  sendAttemptAt DateTime?
  createdById String?
  sourceQuoteId String?
  sourceQuote Quote? @relation("QuoteRevisions", fields:[sourceQuoteId], references:[id], onDelete:SetNull)
  revisions Quote[] @relation("QuoteRevisions")
  version Int @default(1)
  snapshot Json?
  sentAt DateTime?
  viewedAt DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  rfq RFQ? @relation(fields:[rfqId], references:[id], onDelete:SetNull)
  items QuoteItem[]
  events QuoteEvent[]
  followUps FollowUp[]
  acceptance QuoteAcceptance?
  approvals QuoteApproval[]
  attachments Attachment[]
  @@unique([organizationId, number])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, customerId])
}
model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  catalogItemId String?
  nameSnapshot String
  skuSnapshot String?
  descriptionSnapshot String?
  quantity Decimal @db.Decimal(16,4)
  unitSnapshot String
  costSnapshot Decimal @db.Decimal(16,4)
  sellingPrice Decimal @db.Decimal(16,4)
  minimumPriceSnapshot Decimal? @db.Decimal(16,4)
  taxRate Decimal @db.Decimal(7,4)
  sortOrder Int @default(0)
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([quoteId, sortOrder])
}
model QuoteEvent {
  id String @id @default(cuid())
  quoteId String
  type String
  actorUserId String?
  metadata Json?
  createdAt DateTime @default(now())
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([quoteId, createdAt])
}
model QuoteApproval {
  id String @id @default(cuid())
  quoteId String
  quoteVersion Int
  approverUserId String
  financialHash String
  createdAt DateTime @default(now())
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([quoteId, quoteVersion])
  @@unique([quoteId, quoteVersion])
}
model QuoteAcceptance {
  id String @id @default(cuid())
  quoteId String @unique
  quoteVersion Int
  name String
  email String
  statement String
  createdAt DateTime @default(now())
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
}
model FollowUp {
  id String @id @default(cuid())
  organizationId String
  quoteId String
  task String
  dueAt DateTime
  status FollowUpStatus @default(PENDING)
  notes String?
  assignedUserId String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  assignedUser User? @relation(fields:[assignedUserId], references:[id], onDelete:SetNull)
  @@index([organizationId, status, dueAt])
}
model CompanySettings {
  organizationId String @id
  data Json
  marginMode String @default("WARNING")
  minMargin Decimal @default(20) @db.Decimal(7,4)
  quoteValidityDays Int @default(30)
  quoteCounter Int @default(0)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
}
model Subscription {
  id String @id @default(cuid())
  organizationId String @unique
  plan String @default("FREE")
  status String @default("INACTIVE")
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId String?
  stripeProductId String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  trialEnd DateTime?
  lastStripeSyncAt DateTime?
  lastStripeEventAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
}
model AIUsage {
  id String @id @default(cuid())
  organizationId String
  provider String
  feature String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  success Boolean
  requestKey String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, createdAt])
  @@index([requestKey, createdAt])
}
model Attachment {
  id String @id @default(cuid())
  organizationId String
  rfqId String?
  quoteId String?
  storageKey String
  kind String @default("RFQ_ATTACHMENT")
  status String @default("PENDING")
  provider String
  fileName String
  mimeType String
  byteSize Int
  sha256 String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  rfq RFQ? @relation(fields:[rfqId], references:[id], onDelete:Cascade)
  quote Quote? @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([organizationId, createdAt])
  @@index([organizationId, rfqId, status])
  @@index([organizationId, quoteId, status])
  @@unique([organizationId, storageKey])
}
model StripeEvent {
  id String @id
  organizationId String?
  type String
  livemode Boolean
  processedAt DateTime @default(now())
  payloadHash String
  organization Organization? @relation(fields:[organizationId], references:[id], onDelete:SetNull)
  @@index([organizationId, processedAt])
}
model OrganizationDeletionRequest {
  id String @id @default(cuid())
  organizationId String
  requestedById String
  requestedAt DateTime @default(now())
  scheduledFor DateTime
  canceledAt DateTime?
  completedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, scheduledFor])
}
model Integration {
  id String @id @default(cuid())
  organizationId String
  kind IntegrationKind
  provider String
  encryptedConfig Bytes?
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([organizationId, kind])
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String
  actorUserId String?
  action String
  objectType String
  objectId String?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  actor User? @relation(fields:[actorUserId], references:[id], onDelete:SetNull)
  @@index([organizationId, createdAt])
  @@index([organizationId, objectType, objectId])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}
