NODE_ENV=development
APP_URL=http://localhost:8888
PORT=8888

# PostgreSQL (runtime may use a pooled URL; Prisma migrations use a direct URL)
DATABASE_URL=postgresql://user:password@localhost:5432/quoteflow?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/quoteflow?schema=public

# Gemini is only called after an explicit user action. Never expose this in browser code.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_CHARS=30000
AI_MONTHLY_LIMIT_FREE=25
AI_MONTHLY_LIMIT_PRO=500
AI_MONTHLY_LIMIT_BUSINESS=5000

# Optional providers (not enabled until an adapter is configured)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
