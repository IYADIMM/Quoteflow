NODE_ENV=development
APP_URL=http://localhost:8888
PORT=8888

# PostgreSQL (runtime may use a pooled URL; Prisma migrations use a direct URL)
DATABASE_URL=postgresql://user:password@localhost:5432/quoteflow?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/quoteflow?schema=public

# Gemini is only called after an explicit user action. Never expose this in browser code.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_CHARS=30000
AI_MONTHLY_LIMIT_FREE=25
AI_MONTHLY_LIMIT_PRO=500
AI_MONTHLY_LIMIT_BUSINESS=5000

# Optional providers (not enabled until an adapter is configured)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Stripe Checkout and Customer Portal. Keep disabled until test-mode keys, prices and webhook are configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# S3-compatible private object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
STORAGE_ENABLED=false
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_MAX_UPLOAD_BYTES=10485760

# Optional Unicode-capable TTF/OTF used for generated PDFs.
PDF_FONT_PATH=

# Optional distributed rate limiting for horizontally scaled production functions.
RATE_LIMIT_PROVIDER=
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=

