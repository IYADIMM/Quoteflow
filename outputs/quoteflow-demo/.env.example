# SQLite development adapter (current server)
APP_URL=http://localhost:4173
PORT=4173
QUOTE_DATABASE_PATH=./work/quoteflow.sqlite
# PostgreSQL migration target; Prisma schema exists, current runtime remains SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/quoteflow
# The SQLite adapter does not consume AUTH_SECRET; a future production auth provider will.
AUTH_SECRET=replace-with-a-long-random-secret-before-hosting
NODE_ENV=development
# Provider adapters are interfaces only; no provider implementation is wired.
AI_PROVIDER=
AI_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD_HASH=
