generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER ADMIN SALES_MANAGER SALES_REP VIEWER }
enum QuoteStatus { DRAFT INTERNAL_REVIEW SENT VIEWED ACCEPTED REJECTED EXPIRED }
enum RFQStatus { NEW REVIEWING PRICING QUOTED WON LOST EXPIRED CANCELLED }
enum FollowUpStatus { PENDING COMPLETED SNOOZED }
enum CatalogType { PRODUCT SERVICE LABOR MATERIAL PACKAGE }
enum IntegrationKind { AI EMAIL STORAGE BILLING }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  auditLogs AuditLog[]
  assignedFollowUps FollowUp[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model Organization {
  id String @id @default(cuid())
  name String
  reportingCurrency String @default("AED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  settings CompanySettings?
  customers Customer[]
  catalogItems CatalogItem[]
  rfqs RFQ[]
  quotes Quote[]
  followUps FollowUp[]
  attachments Attachment[]
  subscription Subscription?
  integrations Integration[]
  aiUsage AIUsage[]
  auditLogs AuditLog[]
  @@index([createdAt])
}
model Membership {
  id String @id @default(cuid())
  userId String
  organizationId String
  role Role
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([userId,organizationId])
  @@index([organizationId,role])
}
model Customer {
  id String @id @default(cuid())
  organizationId String
  companyName String
  contactName String?
  email String?
  phone String?
  whatsapp String?
  address String?
  country String?
  industry String?
  taxNumber String?
  notes String?
  assignedUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  rfqs RFQ[]
  quotes Quote[]
  @@index([organizationId,companyName])
  @@index([organizationId,deletedAt])
}
model CatalogItem {
  id String @id @default(cuid())
  organizationId String
  sku String?
  name String
  description String?
  category String?
  brand String?
  type CatalogType @default(PRODUCT)
  unit String @default("each")
  cost Decimal @db.Decimal(16,4)
  sellingPrice Decimal @db.Decimal(16,4)
  minimumPrice Decimal? @db.Decimal(16,4)
  taxRate Decimal @default(0) @db.Decimal(7,4)
  currency String
  leadTimeDays Int?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([organizationId,sku])
  @@index([organizationId,name])
  @@index([organizationId,active,deletedAt])
}
model RFQ {
  id String @id @default(cuid())
  organizationId String
  number String
  title String
  customerId String
  receivedAt DateTime @default(now())
  deadline DateTime?
  priority String @default("Normal")
  status RFQStatus @default(NEW)
  source String?
  notes String?
  assignedUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  items RFQItem[]
  quotes Quote[]
  @@unique([organizationId,number])
  @@index([organizationId,status,deadline])
  @@index([organizationId,createdAt])
}
model RFQItem {
  id String @id @default(cuid())
  rfqId String
  description String
  quantity Decimal @db.Decimal(16,4)
  unit String?
  notes String?
  sourceText String?
  confidence Decimal? @db.Decimal(5,4)
  createdAt DateTime @default(now())
  rfq RFQ @relation(fields:[rfqId], references:[id], onDelete:Cascade)
  @@index([rfqId])
}
model Quote {
  id String @id @default(cuid())
  organizationId String
  number String
  customerId String
  rfqId String?
  title String
  status QuoteStatus @default(DRAFT)
  currency String
  issueDate DateTime @default(now())
  expiryDate DateTime?
  discount Decimal @default(0) @db.Decimal(16,4)
  paymentTerms String?
  deliveryTerms String?
  customerNotes String?
  internalNotes String?
  publicTokenHash String? @unique
  publicTokenExpiresAt DateTime?
  version Int @default(1)
  snapshot Json?
  sentAt DateTime?
  viewedAt DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  rfq RFQ? @relation(fields:[rfqId], references:[id], onDelete:SetNull)
  items QuoteItem[]
  events QuoteEvent[]
  followUps FollowUp[]
  acceptance QuoteAcceptance?
  @@unique([organizationId,number])
  @@index([organizationId,status,issueDate])
  @@index([organizationId,customerId])
}
model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  catalogItemId String?
  nameSnapshot String
  skuSnapshot String?
  descriptionSnapshot String?
  quantity Decimal @db.Decimal(16,4)
  unitSnapshot String
  costSnapshot Decimal @db.Decimal(16,4)
  sellingPrice Decimal @db.Decimal(16,4)
  taxRate Decimal @db.Decimal(7,4)
  sortOrder Int @default(0)
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([quoteId,sortOrder])
}
model QuoteEvent {
  id String @id @default(cuid())
  quoteId String
  type String
  actorUserId String?
  metadata Json?
  createdAt DateTime @default(now())
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  @@index([quoteId,createdAt])
}
model QuoteAcceptance {
  id String @id @default(cuid())
  quoteId String @unique
  quoteVersion Int
  name String
  email String
  statement String
  createdAt DateTime @default(now())
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
}
model FollowUp {
  id String @id @default(cuid())
  organizationId String
  quoteId String
  task String
  dueAt DateTime
  status FollowUpStatus @default(PENDING)
  notes String?
  assignedUserId String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade)
  assignedUser User? @relation(fields:[assignedUserId], references:[id], onDelete:SetNull)
  @@index([organizationId,status,dueAt])
}
model Attachment {
  id String @id @default(cuid())
  organizationId String
  storageKey String
  fileName String
  mimeType String
  byteSize Int
  sha256 String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId,createdAt])
}
model CompanySettings {
  organizationId String @id
  data Json
  marginMode String @default("WARNING")
  minMargin Decimal @default(20) @db.Decimal(7,4)
  quoteValidityDays Int @default(30)
  quoteCounter Int @default(0)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
}
model Subscription {
  id String @id @default(cuid())
  organizationId String @unique
  plan String @default("FREE")
  status String @default("INACTIVE")
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  currentPeriodEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
}
model Integration {
  id String @id @default(cuid())
  organizationId String
  kind IntegrationKind
  provider String
  encryptedConfig Bytes?
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([organizationId,kind])
}
model AIUsage {
  id String @id @default(cuid())
  organizationId String
  provider String
  feature String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  success Boolean
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId,createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String
  actorUserId String?
  action String
  objectType String
  objectId String?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  actor User? @relation(fields:[actorUserId], references:[id], onDelete:SetNull)
  @@index([organizationId,createdAt])
  @@index([organizationId,objectType,objectId])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}
